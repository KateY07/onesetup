<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>onesetup</AssemblyName>
    <RootNamespace>OneSetup</RootNamespace>
    <ApplicationIcon>assets\onesetup.ico</ApplicationIcon>
    <Version>4.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The UI shell is built from ui\native (MSVC, C++) on every build and embedded. Pass -p:OneSetupUiExe=<path>
         to embed a prebuilt onesetup-ui.exe instead (no C++ toolchain needed). -->
    <UiShellExe Condition="'$(OneSetupUiExe)' != ''">$(OneSetupUiExe)</UiShellExe>
    <UiShellExe Condition="'$(OneSetupUiExe)' == ''">$(MSBuildProjectDirectory)\obj\ui\onesetup-ui.exe</UiShellExe>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**;ui\**" />
    <None Remove="sfx\7zSD.sfx;vendor\7z.exe;vendor\7z.dll" />
    <EmbeddedResource Include="sfx\7zSD.sfx" LogicalName="OneSetup.7zSD.sfx" />
    <EmbeddedResource Include="vendor\7z.exe" LogicalName="OneSetup.7z.exe" />
    <EmbeddedResource Include="vendor\7z.dll" LogicalName="OneSetup.7z.dll" />
    <EmbeddedResource Include="$(UiShellExe)" LogicalName="OneSetup.ui.exe" />
    <UiShellSource Include="ui\native\main.cpp;ui\native\app.manifest;ui\native\app.rc;ui\native\build.cmd;assets\onesetup.ico" />
  </ItemGroup>
  <Target Name="BuildUiShell" BeforeTargets="CoreCompile" Inputs="@(UiShellSource)" Outputs="$(UiShellExe)" Condition="'$(OneSetupUiExe)' == ''">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\ui\native\build.cmd&quot; &quot;$(UiShellExe)&quot;" />
  </Target>
</Project>
